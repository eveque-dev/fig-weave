{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FigWeave",
  "mainBinaryName": "FigWeave",
  "version": "0.15.0",
  "identifier": "com.figweave.desktop",
  "build": {
    "frontendDist": "shell"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "category": "Productivity",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/128x128.png",
      "icons/icon.png",
      "../assets/icon/icon.icns",
      "../assets/icon/icon.ico"
    ],
    "resources": {
      "../dist/Tavotto": "sidecar/Tavotto",
      "../LICENSE": "LICENSE"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "template": "windows/installer.nsi",
        "installerIcon": "../assets/icon/icon.ico",
        "headerImage": "../assets/brand/installer-header.bmp",
        "sidebarImage": "../assets/brand/installer-sidebar.bmp"
      }
    }
  }
}
