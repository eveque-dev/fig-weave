[Unit]
Description=FigWeave private usage dashboard
After=network.target

[Service]
Type=simple
User=figweave
Group=figweave
WorkingDirectory=/opt/figweave-admin/current
Environment=PYTHONPATH=/opt/figweave-admin/current/src
Environment=TAVOTTO_DATA_DIR=/var/lib/figweave
Environment=FIGWEAVE_ADMIN_CONFIG=/var/lib/figweave/figweave-admin/config.json
ExecStart=/opt/figweave-admin/venv/bin/gunicorn --bind 127.0.0.1:8791 --workers 2 --threads 2 --timeout 15 --no-control-socket --limit-request-line 2048 --limit-request-field_size 4096 services.figweave_admin.app:application
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/figweave

[Install]
WantedBy=multi-user.target
